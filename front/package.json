{
  "name": "wttm-flip",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "prestart": "node scripts/set-env.mjs",
    "start": "ng serve",
    "prebuild": "node scripts/set-env.mjs",
    "build": "ng build",
    "prewatch": "node scripts/set-env.mjs",
    "watch": "ng build --watch --configuration development",
